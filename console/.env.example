# Base URL of the harness API as seen from the BROWSER. Empty = same origin (recommended: Vite proxy in dev,
# nginx in compose). Only set this if you put your own reverse proxy in front.
VITE_API_BASE_URL=
# Dev server only: where the Vite proxy forwards /v1, /healthz, /readyz, /metrics.
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=5180
