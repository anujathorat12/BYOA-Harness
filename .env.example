# Copy to .env. These are LOCAL-ONLY placeholders; use real, random secrets (>= 8 chars) and a secret manager in any
# shared environment. Compose refuses to start if any of the keys/password below is unset.
ADMIN_KEY=change-me-admin
DEV_KEY=change-me-dev
APPROVER_KEY=change-me-approver
AUDITOR_KEY=change-me-auditor
POSTGRES_PASSWORD=change-me-db
# LLM: mock (offline, default) or groq (free-tier key from console.groq.com)
LLM_PROVIDER=mock
GROQ_API_KEY=
# Groq model names change over time; see https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b
# If a TLS-inspecting proxy re-signs HTTPS, put its root CA (PEM) in ./certs/ and set:
# EXTRA_CA_BUNDLE=/certs/corp-ca.pem
