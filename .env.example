# Copy to .env. These are LOCAL-ONLY defaults; use real secrets and a secret manager in any shared environment.
ADMIN_KEY=change-me-admin
DEV_KEY=change-me-dev
APPROVER_KEY=change-me-approver
AUDITOR_KEY=change-me-auditor
POSTGRES_PASSWORD=change-me-db
# LLM: mock (offline, default) or groq (free tier key from console.groq.com)
LLM_PROVIDER=mock
GROQ_API_KEY=
# If a TLS-inspecting proxy re-signs HTTPS, put its root CA (PEM) in ./certs/ and set:
# EXTRA_CA_BUNDLE=/certs/corp-ca.pem
# Groq model (check https://console.groq.com/docs/models; the default is retired/changed over time)
# GROQ_MODEL=openai/gpt-oss-20b
