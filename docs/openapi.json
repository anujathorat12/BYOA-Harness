{
  "components": {
    "schemas": {
      "AgentRegistration": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "title": "Id",
            "type": "string"
          },
          "package": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package"
          },
          "resources": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resources"
          },
          "shape": {
            "title": "Shape",
            "type": "string"
          },
          "spec": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec"
          }
        },
        "required": [
          "id",
          "shape"
        ],
        "title": "AgentRegistration",
        "type": "object"
      },
      "Attach": {
        "additionalProperties": false,
        "properties": {
          "policy_id": {
            "title": "Policy Id",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "policy_id"
        ],
        "title": "Attach",
        "type": "object"
      },
      "Decision": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "title": "Decision",
        "type": "object"
      },
      "EvaluateRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "additionalProperties": true,
            "title": "Action",
            "type": "object"
          },
          "action_count": {
            "default": 0,
            "title": "Action Count",
            "type": "integer"
          },
          "agent_id": {
            "default": "simulated-agent",
            "title": "Agent Id",
            "type": "string"
          },
          "documents": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          },
          "spent_amount": {
            "default": 0.0,
            "title": "Spent Amount",
            "type": "number"
          },
          "spent_tokens": {
            "default": 0,
            "title": "Spent Tokens",
            "type": "integer"
          }
        },
        "required": [
          "documents",
          "action"
        ],
        "title": "EvaluateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PolicyRef": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id"
        ],
        "title": "PolicyRef",
        "type": "object"
      },
      "PolicyUpload": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "maxLength": 512000,
            "title": "Document",
            "type": "string"
          }
        },
        "required": [
          "document"
        ],
        "title": "PolicyUpload",
        "type": "object"
      },
      "SimulateRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "documents": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 8,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documents"
          },
          "limit": {
            "default": 1000,
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "policies": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PolicyRef"
                },
                "maxItems": 8,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policies"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          }
        },
        "title": "SimulateRequest",
        "type": "object"
      },
      "TaskSubmission": {
        "additionalProperties": false,
        "properties": {
          "agent_version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Version"
          },
          "policies": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PolicyRef"
            },
            "maxItems": 8,
            "title": "Policies",
            "type": "array"
          },
          "task": {
            "additionalProperties": true,
            "default": {},
            "title": "Task",
            "type": "object"
          }
        },
        "title": "TaskSubmission",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
